%% Hinh 2.2 - Kien truc phan tang (N-Tier) va huong su kien cua phan he WinForms
flowchart TB
    subgraph PRES["Tầng trình diễn — Presentation Tier"]
        direction LR
        F1["Form1<br/>Đăng nhập"]
        F2["FormMain<br/>Dashboard · CRUD sản phẩm"]
        F3["FormDanhMuc<br/>CRUD danh mục"]
        F4["FormBienTheSanPham<br/>Size · Màu · Tồn kho"]
        F5["FormDonHang<br/>Duyệt đơn · Thanh toán"]
    end

    subgraph EVT["Tầng xử lý sự kiện — Event Handlers"]
        E1["btnDangNhap_Click<br/>xác thực tài khoản"]
        E2["btnThem_Click · btnSua_Click<br/>btnXoa_Click · KiemTraQuyenAdmin"]
        E3["btnThem_Click · btnSua_Click<br/>VariantAlreadyExists"]
        E4["btnDuyetDon_Click<br/>GetAllowedNextStatuses · RestoreOrderStock"]
    end

    subgraph INFRA["Tầng hạ tầng dữ liệu — Data Access Tier"]

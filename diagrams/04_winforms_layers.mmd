        C3["SqlTransaction<br/>đổi trạng thái + hoàn kho nguyên tử"]
    end

    DB[("SQL Server 2022<br/>FashionShopDb")]

    F1 --> E1
    F2 --> E2
    F3 --> E2
    F4 --> E3
    F5 --> E4
    E1 --> C1
    E2 --> C1
    E3 --> C1
    E4 --> C3

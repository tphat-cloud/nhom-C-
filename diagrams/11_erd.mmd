%% Hinh 3.7 - ERD muc logic CSDL FashionShopDb
erDiagram
    ROLES ||--o{ USERS : "phan quyen"
    CATEGORIES ||--o{ PRODUCTS : "chua"
    PRODUCTS ||--o{ PRODUCT_VARIANTS : "co bien the"
    CUSTOMERS |o--o{ ORDERS : "dat"
    ORDERS ||--|{ ORDER_DETAILS : "gom"
    PRODUCTS ||--o{ ORDER_DETAILS : "duoc ban"
    PRODUCT_VARIANTS |o--o{ ORDER_DETAILS : "quy chieu"

    ROLES {
        int RoleId PK
        nvarchar RoleName
        nvarchar Description
    }
    USERS {
        int UserId PK
        nvarchar Username UK
        nvarchar PasswordHash
        nvarchar FullName
        nvarchar Email
        nvarchar PhoneNumber
        int RoleId FK
        bit IsActive
        datetime CreatedAt
    }
    CATEGORIES {
        int CategoryId PK
        nvarchar Name
        nvarchar Description
        nvarchar ImageUrl
        bit IsActive
    }
    PRODUCTS {
        int ProductId PK
        nvarchar ProductCode UK
        nvarchar Name
        nvarchar Description
        decimal Price
        decimal OriginalPrice
        nvarchar ImageUrl
        int CategoryId FK
        bit IsActive
        bit IsFeatured
        datetime CreatedAt
    }
    PRODUCT_VARIANTS {
        int ProductVariantId PK
        int ProductId FK
        nvarchar Size
        nvarchar Color
        int StockQuantity
    }
    CUSTOMERS {
        int CustomerId PK
        nvarchar FullName
        nvarchar PhoneNumber
        nvarchar Email
        nvarchar Address
        datetime CreatedAt
    }
    ORDERS {
        int OrderId PK
        nvarchar OrderCode UK
        datetime OrderDate
        int CustomerId FK
        nvarchar CustomerName
        nvarchar CustomerPhone
        nvarchar ShippingAddress
        nvarchar Note
        decimal TotalAmount
        nvarchar Status
        nvarchar PaymentMethod
        bit IsPaid
    }
    ORDER_DETAILS {
        int OrderDetailId PK
        int OrderId FK
        int ProductId FK
        int ProductVariantId FK
        nvarchar ProductName
        nvarchar Size
        nvarchar Color
        int Quantity
        decimal UnitPrice
        decimal TotalPrice
    }

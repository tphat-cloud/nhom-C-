# Mật khẩu tài khoản "sa" của SQL Server trong container.
# Yêu cầu của SQL Server: tối thiểu 8 ký tự, có chữ HOA, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

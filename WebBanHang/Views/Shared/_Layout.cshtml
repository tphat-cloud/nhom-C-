@inject WebBanHang.Services.ICartService CartService
@{
    int cartCount = CartService.TotalQuantity;

    string currentController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string currentAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;

    bool isHome = currentController == "Home" && currentAction == "Index";
    bool isProducts = currentController == "Products";
    bool isAbout = currentController == "Home" && currentAction == "Privacy";
    bool isCart = currentController == "Cart";
    bool isLookup = currentController == "OrderLookup";

    string pageTitle = ViewData["Title"] as string ?? "Thời trang tối giản";
    string bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ef" />
    <meta name="description" content="Fashion Shop - quần áo thời trang tối giản, chất liệu tốt, giá hợp lý. Miễn phí vận chuyển toàn quốc, đổi trả trong 7 ngày." />
    <title>@pageTitle — Fashion Shop</title>
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>

    <div class="announce">
        <div class="shell announce__row">
            <span>Miễn phí vận chuyển toàn quốc</span>
            <span>Đổi trả trong 7 ngày</span>
            <span>Hotline 1900 6868</span>
        </div>
    </div>

    <header class="site-header">
        <div class="shell header-top">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <strong>Fashion Shop</strong>
                <small>Thời trang tối giản</small>
            </a>

            <form class="search header-search" method="get" asp-area="" asp-controller="Products" asp-action="Index" role="search">
                <label class="visually-hidden" for="siteSearch">Tìm sản phẩm</label>
                <input id="siteSearch" type="search" name="keyword" value="@(ViewData["Keyword"] as string)"
                       placeholder="Tìm áo thun, sơ mi, jeans…" autocomplete="off" />
                <button type="submit" aria-label="Tìm kiếm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-3.5-3.5"></path>
                    </svg>
                </button>
            </form>

            <div class="header-actions">
                <a class="icon-link" asp-area="" asp-controller="OrderLookup" asp-action="Index"
                   aria-label="Tra cứu đơn hàng">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <circle cx="10.5" cy="14.5" r="2.5"></circle>
                        <line x1="12.3" y1="16.3" x2="15.5" y2="19.5"></line>
                    </svg>
                    <span class="icon-link__label">Tra cứu đơn</span>
                </a>
                <a class="icon-link" asp-area="" asp-controller="Cart" asp-action="Index"
                   aria-label="Giỏ hàng (@cartCount sản phẩm)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 8h12l-1.2 11a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 8Z"></path>
                        <path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path>
                    </svg>
                    <span class="icon-link__label">Giỏ hàng</span>
                    @if (cartCount > 0)
                    {
                        <span class="cart-count">@cartCount</span>
                    }
                </a>
            </div>
        </div>

        <nav class="site-nav" aria-label="Điều hướng chính">
            <div class="shell">
                <ul>
                    <li>
                        <a class="@(isHome ? "is-active" : string.Empty)" asp-area="" asp-controller="Home" asp-action="Index"
                           aria-current="@(isHome ? "page" : null)">Trang chủ</a>
                    </li>
                    <li>
                        <a class="@(isProducts ? "is-active" : string.Empty)" asp-area="" asp-controller="Products" asp-action="Index"
                           aria-current="@(isProducts ? "page" : null)">Sản phẩm</a>
                    </li>
                    <li>
                        <a class="@(isLookup ? "is-active" : string.Empty)" asp-area="" asp-controller="OrderLookup" asp-action="Index"
                           aria-current="@(isLookup ? "page" : null)">Tra cứu đơn hàng</a>
                    </li>
                    <li>
                        <a class="@(isCart ? "is-active" : string.Empty)" asp-area="" asp-controller="Cart" asp-action="Index"
                           aria-current="@(isCart ? "page" : null)">Giỏ hàng</a>
                    </li>
                    <li>
                        <a class="@(isAbout ? "is-active" : string.Empty)" asp-area="" asp-controller="Home" asp-action="Privacy"
                           aria-current="@(isAbout ? "page" : null)">Giới thiệu</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main id="main" class="shell">
        @if (TempData["Message"] is string successMessage)
        {
            <div class="alert alert--success" role="status" data-autohide="7000">
                <svg class="alert__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="m8.5 12.5 2.5 2.5 4.5-5"></path>
                </svg>
                <span class="alert__body">@successMessage</span>
                <button type="button" class="alert__close" data-dismiss="alert" aria-label="Đóng thông báo">&times;</button>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert--warning" role="alert">
                <svg class="alert__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4.5 21 20H3L12 4.5Z"></path>
                    <path d="M12 10v4.5"></path>
                    <path d="M12 17.5h.01"></path>
                </svg>
                <span class="alert__body">@errorMessage</span>
                <button type="button" class="alert__close" data-dismiss="alert" aria-label="Đóng thông báo">&times;</button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-grid">
            <div class="footer-brand">
                <strong>Fashion Shop</strong>
                <p>
                    Quần áo tối giản, dễ mặc hằng ngày. Sản phẩm, size/màu và tồn kho
                    được cập nhật trực tiếp từ hệ thống quản lý của cửa hàng.
                </p>
            </div>

            <div>
                <h2 class="footer-title">Mua sắm</h2>
                <ul class="footer-list">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-area="" asp-controller="Products" asp-action="Index">Tất cả sản phẩm</a></li>
                    <li><a asp-area="" asp-controller="OrderLookup" asp-action="Index">Tra cứu đơn hàng</a></li>
                    <li><a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng của bạn</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Hỗ trợ</h2>
                <ul class="footer-list">
                    <li><a asp-area="" asp-controller="OrderLookup" asp-action="Index">Kiểm tra tiến trình đơn</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Về Fashion Shop</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy" asp-fragment="doi-tra">Chính sách đổi trả</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy" asp-fragment="van-chuyen">Vận chuyển &amp; thanh toán</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy" asp-fragment="bao-mat">Bảo mật thông tin</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Liên hệ</h2>
                <ul class="footer-list">
                    <li><span>Hotline: 1900 6868</span></li>
                    <li><span>8:00 – 21:00 hằng ngày</span></li>
                    <li><a href="mailto:hotro@fashionshop.vn">hotro@fashionshop.vn</a></li>
                </ul>
            </div>
        </div>

        <div class="shell footer-bottom">
            <span>&copy; @DateTime.Now.Year Fashion Shop — Đồ án môn Ngôn ngữ lập trình C#</span>
            <nav aria-label="Liên kết chân trang">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Giới thiệu</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" asp-fragment="doi-tra">Đổi trả</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" asp-fragment="bao-mat">Bảo mật</a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

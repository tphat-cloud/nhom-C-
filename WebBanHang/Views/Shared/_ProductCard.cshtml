@model Product

<div class="col">
    <div class="card h-100 product-card shadow-sm">
        <a asp-controller="Products" asp-action="Detail" asp-route-id="@Model.ProductId">
            <img src="@Model.DisplayImage" class="card-img-top product-thumb" alt="@Model.Name" loading="lazy" />
        </a>
        <div class="card-body d-flex flex-column">
            <div class="text-uppercase text-muted small mb-1">@Model.CategoryName</div>
            <h6 class="card-title mb-2">
                <a class="text-decoration-none text-dark" asp-controller="Products" asp-action="Detail" asp-route-id="@Model.ProductId">
                    @Model.Name
                </a>
            </h6>

            <div class="d-flex align-items-baseline flex-wrap gap-2 mt-auto">
                <span class="fw-bold text-danger">@Model.Price.ToString("N0") đ</span>
                @if (Model.DiscountPercent > 0)
                {
                    <span class="text-muted text-decoration-line-through small">@(Model.OriginalPrice?.ToString("N0")) đ</span>
                    <span class="badge bg-danger">-@(Model.DiscountPercent)%</span>
                }
            </div>

            <div class="mt-2">
                <span class="badge @(Model.IsInStock ? "bg-success" : "bg-secondary")">@Model.StockText</span>
            </div>
        </div>
    </div>
</div>

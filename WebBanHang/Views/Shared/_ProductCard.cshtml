@model Product
@{
    string fallback = Model.FallbackImage;
}
<article class="product-card reveal">
    <a class="product-card__media" asp-area="" asp-controller="Products" asp-action="Detail" asp-route-id="@Model.ProductId"
       aria-label="Xem chi tiết @Model.Name">
        <img src="@Model.DisplayImage" alt="@Model.Name" loading="lazy" width="600" height="800"
             data-fallback="@fallback" />

        @if (Model.DiscountPercent > 0)
        {
            <span class="product-card__flag">-@(Model.DiscountPercent)%</span>
        }
        @if (!Model.IsInStock)
        {
            <span class="product-card__soldout">Hết hàng</span>
        }

        <span class="product-card__hint">Xem chi tiết</span>
    </a>

    <div class="product-card__body">
        <p class="product-card__cat">@Model.CategoryName</p>

        <h3 class="product-card__name">
            <a asp-area="" asp-controller="Products" asp-action="Detail" asp-route-id="@Model.ProductId">@Model.Name</a>
        </h3>

        <p class="product-card__price">
            <span class="price">@Model.Price.ToString("N0") đ</span>
            @if (Model.DiscountPercent > 0)
            {
                <s class="price-old">@(Model.OriginalPrice?.ToString("N0")) đ</s>
                <span class="price-off">-@(Model.DiscountPercent)%</span>
            }
        </p>

        @if (!Model.IsInStock)
        {
            <p class="product-card__stock is-out">Tạm hết hàng</p>
        }
        else if (Model.TotalStock <= 5)
        {
            <p class="product-card__stock is-low">Sắp hết hàng</p>
        }
    </div>
</article>

@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="empty" style="margin-top:2rem">
    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7.5v5.5"></path>
        <path d="M12 16.5h.01"></path>
    </svg>

    <h2>Đã có lỗi xảy ra</h2>
    <p>
        Rất tiếc, yêu cầu của bạn chưa được xử lý. Vui lòng thử lại, hoặc quay về trang chủ
        nếu lỗi vẫn tiếp tục.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Mã yêu cầu: <code>@Model.RequestId</code>
        </p>
    }

    <div class="page-actions page-actions--center">
        <a class="btn btn--ink" asp-area="" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        <a class="btn btn--line" asp-area="" asp-controller="Products" asp-action="Index">Xem sản phẩm</a>
    </div>
</div>

@model OrderLookupViewModel
@{
    ViewData["Title"] = "Tra cứu đơn hàng";
}

<div class="lookup-page">
    <!-- Header giới thiệu trang -->
    <header class="page-head center">
        <p class="eyebrow">Trải nghiệm khách hàng</p>
        <h1 class="page-title">Tra cứu đơn hàng</h1>
        <p class="page-desc">
            Nhập <strong>Mã đơn hàng</strong> và <strong>Số điện thoại</strong> bạn đã dùng khi đặt hàng để theo dõi tiến trình giao hàng theo thời gian thực.
        </p>
    </header>

    <!-- Khung tìm kiếm đơn hàng -->
    <section class="lookup-box" aria-labelledby="lookupBoxTitle">
        <h2 id="lookupBoxTitle" class="visually-hidden">Tìm kiếm đơn hàng</h2>
        <form method="get" asp-controller="OrderLookup" asp-action="Index" class="lookup-form" role="search">
            <div class="lookup-form__group">
                <label for="orderCode" class="lookup-form__label">
                    <span>Mã đơn hàng</span>
                    <span class="required" aria-hidden="true">*</span>
                </label>
                <div class="input-wrap">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                        <line x1="2" x2="22" y1="10" y2="10"></line>
                    </svg>
                    <input id="orderCode"
                           name="orderCode"
                           type="text"
                           value="@Model.OrderCodeInput"
                           placeholder="Ví dụ: DH260416-0001"
                           class="lookup-input"
                           required
                           autocomplete="off"
                           spellcheck="false" />
                </div>
            </div>

            <div class="lookup-form__group">
                <label for="phoneNumber" class="lookup-form__label">
                    <span>Số điện thoại</span>
                    <span class="required" aria-hidden="true">*</span>
                </label>
                <div class="input-wrap">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <input id="phoneNumber"
                           name="phoneNumber"
                           type="tel"
                           value="@Model.PhoneNumberInput"
                           placeholder="Ví dụ: 0901234567"
                           class="lookup-input"
                           required
                           autocomplete="tel" />
                </div>
            </div>

            <div class="lookup-form__actions">
                <button type="submit" class="btn btn--ink btn--block">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                    </svg>
                    <span>Tra cứu đơn hàng</span>
                </button>
            </div>
        </form>

        <p class="lookup-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" x2="12" y1="16" y2="12"></line>
                <line x1="12" x2="12.01" y1="8" y2="8"></line>
            </svg>
            <span>Mã đơn hàng được tạo tự động khi bạn hoàn tất đặt hàng (ví dụ: <code>DH26...</code>).</span>
        </p>
    </section>

    <!-- Khi không tìm thấy đơn hoặc có lỗi -->
    @if (Model.HasSearched && !Model.IsFound)
    {
        <div class="lookup-notfound alert alert--warning" role="alert">
            <div class="lookup-notfound__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" x2="12" y1="8" y2="12"></line>
                    <line x1="12" x2="12.01" y1="16" y2="16"></line>
                </svg>
            </div>
            <div class="lookup-notfound__content">
                <h3 class="lookup-notfound__title">Không tìm thấy thông tin đơn hàng</h3>
                <p class="lookup-notfound__text">
                    @(Model.ErrorMessage ?? "Không tìm thấy đơn hàng phù hợp với mã đơn và số điện thoại đã nhập.")
                </p>
                <ul class="lookup-notfound__tips">
                    <li>Vui lòng kiểm tra lại chính xác từng ký tự trong <strong>Mã đơn hàng</strong> (không chứa khoảng trắng thừa).</li>
                    <li>Đảm bảo nhập đúng <strong>Số điện thoại</strong> đã điền ở trang thanh toán khi mua hàng.</li>
                    <li>Nếu cần hỗ trợ khẩn cấp, bạn có thể gọi hotline <a href="tel:19006868"><strong>1900 6868</strong></a> (8:00 – 21:00) để nhân viên hỗ trợ tra cứu trực tiếp.</li>
                </ul>
            </div>
        </div>
    }

    <!-- KẾT QUẢ TRA CỨU KHI TÌM THẤY ĐƠN HÀNG -->
    @if (Model.HasSearched && Model.IsFound)
    {
        <div class="lookup-result">
            <!-- Thẻ tóm tắt mã đơn & trạng thái -->
            <div class="lookup-card lookup-summary">
                <div class="lookup-summary__meta">
                    <span class="lookup-summary__label">Mã đơn hàng</span>
                    <div class="confirm__code lookup-summary__code">
                        <span>@Model.OrderCode</span>
                        <button type="button" data-copy="@Model.OrderCode" aria-label="Sao chép mã đơn hàng">Sao chép</button>
                    </div>
                    <span class="lookup-summary__date">Đặt lúc: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="lookup-summary__status">
                    <span class="lookup-summary__label">Trạng thái hiện tại</span>
                    <div class="lookup-status-pill">
                        <span class="@Model.StatusBadgeClass">@Model.Status</span>
                        @if (Model.IsPaid)
                        {
                            <span class="pill pill--success">Đã thanh toán</span>
                        }
                        else
                        {
                            <span class="pill pill--low">Chưa thanh toán</span>
                        }
                    </div>
                </div>
            </div>

            <!-- TIẾN TRÌNH GIAO HÀNG (TIMELINE / STEPPER) -->
            <section class="lookup-card lookup-stepper" aria-labelledby="progressTitle">
                <div class="lookup-stepper__head">
                    <h2 id="progressTitle" class="panel__title">Tiến trình đơn hàng</h2>
                    <p class="lookup-stepper__desc">@Model.StatusDescription</p>
                </div>

                @if (Model.IsCancelled)
                {
                    <div class="lookup-cancelled-banner">
                        <div class="lookup-cancelled-banner__icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" x2="9" y1="9" y2="15"></line>
                                <line x1="9" x2="15" y1="9" y2="15"></line>
                            </svg>
                        </div>
                        <div>
                            <strong>Đơn hàng đã được đánh dấu hủy</strong>
                            <p>Đơn hàng này hiện không tiếp tục giao. Nếu bạn không yêu cầu hủy hoặc cần đặt lại, hãy liên hệ tổng đài <strong>1900 6868</strong> để được hỗ trợ nhanh nhất.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="stepper">
                        @{
                            var steps = new (string Key, string Title, string Desc)[]
                            {
                                (OrderStatuses.Pending, "Chờ xử lý", "Đã tiếp nhận đơn hàng"),
                                (OrderStatuses.Approved, "Đã duyệt", "Đang chuẩn bị đóng gói"),
                                (OrderStatuses.Shipping, "Đang giao", "Bàn giao vận chuyển"),
                                (OrderStatuses.Completed, "Hoàn thành", "Giao hàng thành công")
                            };
                            int currentStep = Model.CurrentStep;
                        }

                        @for (int i = 0; i < steps.Length; i++)
                        {
                            int stepIndex = i + 1;
                            bool isCompleted = stepIndex < currentStep;
                            bool isCurrent = stepIndex == currentStep;
                            string stepClass = isCompleted ? "is-completed" : (isCurrent ? "is-active" : "is-upcoming");

                            <div class="stepper__item @stepClass">
                                <div class="stepper__marker">
                                    @if (isCompleted)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="stepper__dot"></span>
                                    }
                                    else
                                    {
                                        <span>@stepIndex</span>
                                    }
                                </div>
                                <div class="stepper__content">
                                    <h3 class="stepper__title">@steps[i].Title</h3>
                                    <p class="stepper__text">@steps[i].Desc</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- CHI TIẾT ĐƠN HÀNG & THÔNG TIN GIAO NHẬN -->
            <div class="lookup-grid">
                <!-- Cột 1: Danh sách sản phẩm -->
                <section class="lookup-card" aria-labelledby="itemsTitle">
                    <h2 id="itemsTitle" class="panel__title">Sản phẩm trong đơn (@Model.Items.Count món)</h2>

                    <ul class="lookup-items">
                        @foreach (var item in Model.Items)
                        {
                            <li class="lookup-item">
                                <div class="lookup-item__media">
                                    <img src="@item.DisplayImage" alt="@item.ProductName" loading="lazy" width="70" height="90" />
                                </div>
                                <div class="lookup-item__body">
                                    <h3 class="lookup-item__name">@item.ProductName</h3>
                                    <div class="lookup-item__tags">
                                        @if (!string.IsNullOrWhiteSpace(item.Size))
                                        {
                                            <span class="opt-chip">Size: @item.Size</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Color))
                                        {
                                            <span class="opt-chip">Màu: @item.Color</span>
                                        }
                                    </div>
                                    <div class="lookup-item__meta">
                                        <span>Số lượng: <strong>@item.Quantity</strong></span>
                                        <span>&times;</span>
                                        <span>@item.UnitPrice.ToString("N0") đ</span>
                                    </div>
                                </div>
                                <div class="lookup-item__total">
                                    <span>@item.TotalPrice.ToString("N0") đ</span>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="lookup-pricing">
                        <div class="lookup-pricing__row">
                            <span>Tạm tính</span>
                            <span>@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="lookup-pricing__row">
                            <span>Phí vận chuyển</span>
                            <span class="text-free">Miễn phí toàn quốc</span>
                        </div>
                        <div class="lookup-pricing__row lookup-pricing__row--total">
                            <span>Tổng thanh toán</span>
                            <span class="price">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>
                </section>

                <!-- Cột 2: Thông tin giao nhận & Người mua -->
                <div class="lookup-sidebar">
                    <section class="lookup-card" aria-labelledby="deliveryInfoTitle">
                        <h2 id="deliveryInfoTitle" class="panel__title">Thông tin giao nhận</h2>
                        <ul class="info-list">
                            <li>
                                <span class="label">Người nhận</span>
                                <span class="value">@Model.CustomerName</span>
                            </li>
                            <li>
                                <span class="label">Điện thoại</span>
                                <span class="value"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></span>
                            </li>
                            <li>
                                <span class="label">Địa chỉ nhận</span>
                                <span class="value">@Model.ShippingAddress</span>
                            </li>
                            <li>
                                <span class="label">Ghi chú</span>
                                <span class="value">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</span>
                            </li>
                        </ul>
                    </section>

                    <section class="lookup-card" aria-labelledby="paymentInfoTitle">
                        <h2 id="paymentInfoTitle" class="panel__title">Thanh toán</h2>
                        <ul class="info-list">
                            <li>
                                <span class="label">Hình thức</span>
                                <span class="value">@Model.PaymentMethodText</span>
                            </li>
                            <li>
                                <span class="label">Tình trạng</span>
                                <span class="value">
                                    @if (Model.IsPaid)
                                    {
                                        <span class="pill pill--success">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill--warning">Chờ thanh toán khi nhận hàng</span>
                                    }
                                </span>
                            </li>
                        </ul>
                    </section>

                    <section class="lookup-card lookup-support" aria-labelledby="supportTitle">
                        <h2 id="supportTitle" class="panel__title">Cần trợ giúp đơn này?</h2>
                        <p class="lookup-support__text">
                            Nếu bạn muốn đổi địa chỉ giao hàng hoặc có câu hỏi về kiện hàng, vui lòng gọi hotline của cửa hàng:
                        </p>
                        <a href="tel:19006868" class="btn btn--line btn--block">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <span>Hotline 1900 6868</span>
                        </a>
                    </section>
                </div>
            </div>

            <!-- Nút điều hướng chân trang -->
            <div class="page-actions page-actions--center lookup-bottom-actions">
                <button type="button" class="btn btn--line" onclick="window.print()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect width="12" height="8" x="6" y="14"></rect>
                    </svg>
                    <span>In thông tin đơn</span>
                </button>
                <a class="btn btn--ink" asp-area="" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>
            </div>
        </div>
    }

    <!-- HƯỚNG DẪN KHI KHÁCH VỪA VÀO TRANG LẦN ĐẦU -->
    @if (!Model.HasSearched)
    {
        <div class="lookup-faq-grid">
            <div class="lookup-faq-card">
                <div class="lookup-faq-card__icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" x2="8" y1="13" y2="13"></line>
                        <line x1="16" x2="8" y1="17" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <h3>Lấy mã đơn hàng ở đâu?</h3>
                <p>Mã đơn hàng hiển thị tại trang thông báo đặt hàng thành công ngay sau khi bạn gửi đơn (dạng <code>DH26...</code>). Nếu quên, bạn có thể gọi hotline để nhân viên hỗ trợ.</p>
            </div>

            <div class="lookup-faq-card">
                <div class="lookup-faq-card__icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                        <line x1="16" x2="16" y1="2" y2="6"></line>
                        <line x1="8" x2="8" y1="2" y2="6"></line>
                        <line x1="3" x2="21" y1="10" y2="10"></line>
                    </svg>
                </div>
                <h3>Thời gian giao hàng</h3>
                <p>Đơn nội thành giao trong 1–2 ngày làm việc. Các tỉnh thành khác giao từ 2–4 ngày làm việc. Miễn phí vận chuyển cho tất cả đơn hàng.</p>
            </div>

            <div class="lookup-faq-card">
                <div class="lookup-faq-card__icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h3>Bảo mật thông tin</h3>
                <p>Hệ thống chỉ hiển thị chi tiết khi nhập khớp cả Mã đơn hàng và Số điện thoại đặt hàng, nhằm bảo đảm quyền riêng tư tuyệt đối cho khách hàng.</p>
            </div>
        </div>
    }
</div>

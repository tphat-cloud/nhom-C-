@using WebBanHang.Services
@model IReadOnlyList<CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    decimal totalAmount = Model.Sum(item => item.TotalPrice);
    int totalQuantity = Model.Sum(item => item.Quantity);
}

<div class="page-head">
    <p class="eyebrow">Bước 1 / 2</p>
    <h1>Giỏ hàng</h1>
    <p>Kiểm tra sản phẩm, size và số lượng trước khi tiến hành đặt hàng.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 8h12l-1.2 11a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 8Z"></path>
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path>
        </svg>
        <h2>Giỏ hàng đang trống</h2>
        <p>Bạn chưa chọn món nào. Hãy xem bộ sưu tập và thêm vài món đồ yêu thích nhé.</p>
        <a class="btn btn--ink" asp-area="" asp-controller="Products" asp-action="Index">Xem sản phẩm</a>
    </div>
}
else
{
    <div class="cart-layout">
        <div>
            <ul class="cart-list">
                @foreach (CartItem item in Model)
                {
                    <li class="cart-row">
                        <a class="cart-row__media" asp-area="" asp-controller="Products" asp-action="Detail"
                           asp-route-id="@item.ProductId" aria-label="Xem @item.ProductName">
                            <img src="@item.DisplayImage" alt="@item.ProductName" width="220" height="293"
                                 loading="lazy" data-fallback="/images/no-image.svg" />
                        </a>

                        <div class="cart-row__body">
                            <a class="cart-row__name" asp-area="" asp-controller="Products" asp-action="Detail"
                               asp-route-id="@item.ProductId">@item.ProductName</a>

                            <div class="cart-row__opts">
                                <span class="opt-chip">Size @item.Size</span>
                                <span class="opt-chip">Màu @item.Color</span>
                            </div>

                            <div class="cart-row__qty">
                                <form method="post" asp-area="" asp-controller="Cart" asp-action="Update"
                                      data-submit-once>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="variantId" value="@item.ProductVariantId" />
                                    <div class="qty">
                                        <button type="button" data-step="-1" aria-label="Giảm số lượng">&minus;</button>
                                        <input type="number" name="quantity" value="@item.Quantity" min="1"
                                               max="@ICartService.MaxQuantityPerItem" step="1" data-autosubmit
                                               aria-label="Số lượng @item.ProductName" />
                                        <button type="button" data-step="1" aria-label="Tăng số lượng">+</button>
                                    </div>
                                    <button type="submit" class="btn btn--line btn--sm">Cập nhật</button>
                                </form>

                                <form method="post" asp-area="" asp-controller="Cart" asp-action="Remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="variantId" value="@item.ProductVariantId" />
                                    <button type="submit" class="link-danger"
                                            data-confirm="Xóa sản phẩm này khỏi giỏ hàng?">Xóa</button>
                                </form>
                            </div>
                        </div>

                        <div class="cart-row__price">
                            <span class="cart-row__total">@item.TotalPrice.ToString("N0") đ</span>
                            <span class="cart-row__unit">@item.UnitPrice.ToString("N0") đ / sản phẩm</span>
                        </div>
                    </li>
                }
            </ul>

            <div class="page-actions">
                <a class="btn btn--line" asp-area="" asp-controller="Products" asp-action="Index">
                    &larr; Tiếp tục mua sắm
                </a>
                <form method="post" asp-area="" asp-controller="Cart" asp-action="Clear">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--quiet"
                            data-confirm="Xóa toàn bộ sản phẩm trong giỏ hàng?">Xóa toàn bộ giỏ</button>
                </form>
            </div>
        </div>

        <aside class="summary" aria-label="Tóm tắt đơn hàng">
            <h2 class="summary__title">Đơn hàng của bạn</h2>

            <ul class="summary__items">
                @foreach (CartItem item in Model)
                {
                    <li class="summary__item">
                        <img src="@item.DisplayImage" alt="@item.ProductName" loading="lazy"
                             data-fallback="/images/no-image.svg" />
                        <div>
                            <div class="summary__item-name">@item.ProductName</div>
                            <div class="summary__item-meta">@item.Size · @item.Color · SL @item.Quantity</div>
                        </div>
                        <div class="summary__item-price">@item.TotalPrice.ToString("N0") đ</div>
                    </li>
                }
            </ul>

            <div class="summary__row">
                <span>Tạm tính (@totalQuantity sản phẩm)</span>
                <span>@totalAmount.ToString("N0") đ</span>
            </div>
            <div class="summary__row">
                <span>Vận chuyển</span>
                <span>Miễn phí</span>
            </div>
            <div class="summary__row summary__row--total">
                <span>Tổng cộng</span>
                <span>@totalAmount.ToString("N0") đ</span>
            </div>

            <div class="summary__actions">
                <a class="btn btn--ink btn--block" asp-area="" asp-controller="Checkout" asp-action="Index">
                    Tiến hành đặt hàng
                </a>
                <a class="btn btn--quiet" asp-area="" asp-controller="Products" asp-action="Index">Mua thêm sản phẩm</a>
            </div>

            <p class="summary__note">
                Giá bán và tồn kho được kiểm tra lại từ hệ thống khi bạn xác nhận đặt hàng.
                Nếu một món vừa hết, đơn sẽ không được tạo và giỏ hàng của bạn vẫn được giữ nguyên.
            </p>
        </aside>
    </div>
}

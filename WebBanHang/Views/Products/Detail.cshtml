@using WebBanHang.Services
@model Product
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <img src="@Model.DisplayImage" class="img-fluid rounded border w-100" alt="@Model.Name" />
    </div>

    <div class="col-12 col-md-6">
        <div class="text-uppercase text-muted small mb-1">
            @Model.CategoryName &middot; Mã: @Model.ProductCode
        </div>
        <h2 class="mb-2">@Model.Name</h2>

        <div class="d-flex align-items-baseline flex-wrap gap-2 mb-3">
            <span class="fs-4 fw-bold text-danger">@Model.Price.ToString("N0") đ</span>
            @if (Model.DiscountPercent > 0)
            {
                <span class="text-muted text-decoration-line-through">@(Model.OriginalPrice?.ToString("N0")) đ</span>
                <span class="badge bg-danger">-@(Model.DiscountPercent)%</span>
            }
        </div>

        <p class="text-muted">@Model.Description</p>

        <p>
            <span class="badge @(Model.IsInStock ? "bg-success" : "bg-secondary")">@Model.StockText</span>
        </p>

        <h6 class="mt-4">Size &amp; màu</h6>

        @if (Model.Variants.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                Sản phẩm chưa có biến thể size/màu trong cơ sở dữ liệu.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Size</th>
                            <th>Màu</th>
                            <th class="text-end">Tình trạng</th>
                            <th class="text-end">Chọn mua</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in Model.Variants)
                        {
                            <tr>
                                <td>@variant.Size</td>
                                <td>@variant.Color</td>
                                <td class="text-end">
                                    @* Không hiển thị số lượng tồn kho cho khách — chỉ tình trạng *@
                                    @if (variant.IsAvailable)
                                    {
                                        <span class="badge bg-success">Còn hàng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hết hàng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (variant.IsAvailable)
                                    {
                                        <form method="post" asp-controller="Cart" asp-action="Add"
                                              class="d-inline-flex gap-1 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="variantId" value="@variant.ProductVariantId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <input class="form-control form-control-sm cart-qty" type="number"
                                                   name="quantity" value="1" min="1" max="@ICartService.MaxQuantityPerItem"
                                                   aria-label="Số lượng size @variant.Size màu @variant.Color" />
                                            <button type="submit" class="btn btn-sm btn-dark text-nowrap">
                                                Thêm vào giỏ
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tạm hết</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mt-2 mb-0">
                Số lượng tồn kho chi tiết được quản lý trong ứng dụng nội bộ của cửa hàng.
            </p>
        }

        <a class="btn btn-outline-dark mt-4" asp-controller="Products" asp-action="Index">
            &larr; Tiếp tục xem sản phẩm
        </a>
    </div>
</div>

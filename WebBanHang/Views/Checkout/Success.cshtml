@using System.Globalization
@model OrderSuccessViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";

    string paymentLabel = Model.PaymentMethod == PaymentMethods.BankTransfer
        ? "Chuyển khoản ngân hàng"
        : "Thanh toán khi nhận hàng (COD)";
}

<div class="confirm">
    <div class="confirm__head">
        <div class="confirm__icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12.5 4.5 4.5L19 7"></path>
            </svg>
        </div>
        <h1 class="confirm__title">Đặt hàng thành công</h1>
        <p class="confirm__sub">
            Cảm ơn bạn, @Model.CustomerName! Cửa hàng sẽ gọi xác nhận trong thời gian sớm nhất.
        </p>

        <div class="confirm__code">
            <span>@Model.OrderCode</span>
            <button type="button" data-copy="@Model.OrderCode" aria-label="Sao chép mã đơn hàng">Sao chép</button>
        </div>
    </div>

    <section class="panel" aria-labelledby="orderInfo">
        <h2 class="panel__title" id="orderInfo">Thông tin đơn hàng</h2>

        <ul class="info-list">
            <li>
                <span class="label">Người nhận</span>
                <span class="value">@Model.CustomerName</span>
            </li>
            <li>
                <span class="label">Điện thoại</span>
                <span class="value"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></span>
            </li>
            <li>
                <span class="label">Địa chỉ</span>
                <span class="value">@Model.Address</span>
            </li>
            <li>
                <span class="label">Thanh toán</span>
                <span class="value">@paymentLabel</span>
            </li>
            <li>
                <span class="label">Tổng tiền</span>
                <span class="value">@Model.TotalText</span>
            </li>
            <li>
                <span class="label">Trạng thái</span>
                <span class="value"><span class="pill pill--low">@OrderStatuses.Pending</span></span>
            </li>
        </ul>
    </section>

    <section class="panel" aria-labelledby="nextSteps">
        <h2 class="panel__title" id="nextSteps">Bước tiếp theo</h2>

        <ol class="steps">
            <li>
                <strong>Cửa hàng gọi xác nhận</strong>
                Trong giờ làm việc 8:00 – 21:00, nhân viên sẽ gọi số @Model.PhoneNumber để xác nhận đơn.
            </li>
            <li>
                <strong>Đóng gói &amp; giao hàng</strong>
                Đơn được giao trong 2–4 ngày làm việc, miễn phí vận chuyển toàn quốc.
            </li>
            <li>
                <strong>Kiểm tra và thanh toán</strong>
                @Model.PaymentHint
            </li>
        </ol>
    </section>

    <p class="summary__note center mt-3">
        Vui lòng lưu lại mã đơn hàng <strong>@Model.OrderCode</strong> hoặc bấm nút tra cứu bên dưới để theo dõi trạng thái đơn hàng bất cứ lúc nào.
        Đơn này cũng đã được lưu trên <strong>thiết bị này</strong> để lần sau tra cứu chỉ với một cú bấm.
    </p>

    <div class="page-actions page-actions--center">
        <a class="btn btn--ink" asp-area="" asp-controller="OrderLookup" asp-action="Index" asp-route-orderCode="@Model.OrderCode" asp-route-phoneNumber="@Model.PhoneNumber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
            </svg>
            <span>Tra cứu tiến trình đơn hàng</span>
        </a>
        <a class="btn btn--line" asp-area="" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>
        <a class="btn btn--line" asp-area="" asp-controller="Home" asp-action="Index">Về trang chủ</a>
    </div>
</div>

@* Dữ liệu cho site.js: lưu đơn vừa đặt vào LocalStorage ("Đơn hàng gần đây của bạn", tối đa 5 đơn) *@
<script type="application/json" id="recentOrderData">@(Json.Serialize(new
    {
        orderCode = Model.OrderCode,
        phone = Model.PhoneNumber,
        orderDate = Model.OrderDate.ToString("s", CultureInfo.InvariantCulture),
        totalAmount = Model.TotalAmount
    }))</script>
